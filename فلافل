<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<title>كاشير فلافل بالإيموجي</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
body{
    margin:0;
    font-family: Tahoma;
    background:#f1f5f9;
}

.header{
    background:#15803d;
    color:white;
    text-align:center;
    padding:15px;
    font-size:22px;
}

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
    gap:10px;
    padding:10px;
}

.card{
    background:white;
    border-radius:12px;
    overflow:hidden;
    box-shadow:0 0 6px #999;
    text-align:center;
    font-size:20px;
}

.emoji{
    font-size:50px;
    padding-top:10px;
}

.name{font-weight:bold;margin:5px 0}
.price{color:green;font-weight:bold}

.btn{
    width:100%;
    padding:8px;
    border:none;
    color:white;
    font-size:15px;
}

.b1{background:#2563eb}
.b2{background:#db2777}
.b3{background:#059669}
.b4{background:#ea580c}
.b5{background:#0284c7}
.b6{background:#f59e0b}

.cart{
    background:white;
    margin:10px;
    padding:10px;
    border-radius:10px;
}

.item{
    display:flex;
    justify-content:space-between;
    border-bottom:1px solid #ddd;
    padding:5px;
}

.total{
    font-size:20px;
    text-align:center;
    margin-top:10px;
}

.printBtn, .totalBtn, .clearBtn{
    background:#15803d;
    color:white;
    width:100%;
    padding:12px;
    border:none;
    border-radius:10px;
    margin-top:10px;
    font-size:18px;
}
</style>
</head>

<body>

<div class="header">كاشير كافتريا فلافل</div>

<div class="grid" id="products"></div>

<div class="cart">
<h3>الطلبات</h3>
<div id="cart"></div>
<div class="total">المجموع: <span id="total">0</span></div>

<button class="printBtn" onclick="printInvoice()">طباعة الفاتورة</button>
<button class="totalBtn" onclick="requestPassword()">المجموع الكلي</button>
<button class="clearBtn" onclick="clearSales()">مسح الطلبات</button>
</div>

<script>
let products=[
{name:"لفة فلافل",price:500,emoji:"🌯",b:"b1"},
{name:"لفة مشكل",price:750,emoji:"🥙",b:"b2"},
{name:"وجبة فلافل",price:1500,emoji:"🟤",b:"b3"},
{name:"بيبسي",price:500,emoji:"🥤",b:"b4"},
{name:"ماء",price:250,emoji:"💧",b:"b5"},
{name:"لفة بركر",price:500,emoji:"🍔",b:"b6"},
];

let cart=[]; // الطلبات الحالية
let salesHistory=[]; // كل المبيعات حتى الآن

// تحميل المنتجات
function load(){
let p=document.getElementById("products");
p.innerHTML="";
products.forEach((x,i)=>{
p.innerHTML+=`
<div class="card">
<div class="emoji">${x.emoji}</div>
<div class="name">${x.name}</div>
<div class="price">${x.price}</div>
<button class="btn ${x.b}" onclick="add(${i})">إضافة</button>
</div>`;
});
}
load();

// إضافة صنف للسلة
function add(i){
cart.push(products[i]);
drawCart();
}

// رسم السلة
function drawCart(){
let c=document.getElementById("cart");
c.innerHTML="";
let t=0;
cart.forEach(x=>{
c.innerHTML+=`<div class="item"><span>${x.emoji} ${x.name}</span><span>${x.price}</span></div>`;
t+=x.price;
});
document.getElementById("total").innerText=t;
}

// طباعة الفاتورة
function printInvoice(){
if(cart.length==0){alert("لا توجد طلبات");return;}

let w=window.open("","_blank");
w.document.write(`
<html dir="rtl">
<head>
<title>فاتورة</title>
<style>
body{font-family:Tahoma;text-align:center;}
h2{text-align:center}
table{width:100%;border-collapse:collapse;margin-top:20px}
td,th{border:1px solid #000;padding:5px;text-align:center}
</style>
</head>
<body onload="window.print()">
<h2>فاتورة كافتريا فلافل</h2>
<table>
<tr><th>الصنف</th><th>السعر</th></tr>
${cart.map(x=>`<tr><td>${x.emoji} ${x.name}</td><td>${x.price}</td></tr>`).join("")}
<tr><th>المجموع</th><th>${cart.reduce((a,b)=>a+b.price,0)}</th></tr>
</table>
<p>شكراً لزيارتكم 🌹</p>
</body>
</html>
`);
w.document.close();

// إضافة الطلبات للمبيعات الكلية
salesHistory.push(...cart);

// تفريغ السلة بعد الطباعة
cart=[];
drawCart();
}

// مسح السلة فقط (اليوم الحالي)
function clearCart(){
    cart=[];
    drawCart();
    document.getElementById("total").innerText = 0;
}

// مسح كل المبيعات (بدء يوم جديد)
function clearSales(){
    if(confirm("هل تريد فعلاً مسح كل الطلبات والمبيعات للبدء بيوم جديد؟")){
        salesHistory = []; // تفريغ المبيعات الكلية
        clearCart(); // تفريغ السلة الحالية
        alert("تم مسح جميع الطلبات والمبيعات، يمكنك البدء بيوم جديد.");
    }
}

// حماية المجموع الكلي برمز
function requestPassword(){
let pass = prompt("ادخل الرمز للوصول للمجموع الكلي:");
if(pass === "20002000"){
showTotal();
}else{
alert("رمز خاطئ! لا يمكن الوصول للمبيعات الكلية.");
}
}

// عرض المبيعات الكلية
function showTotal(){
if(salesHistory.length==0){alert("لا يوجد مبيعات حتى الآن");return;}

let w=window.open("","_blank");
w.document.write(`
<html dir="rtl">
<head>
<title>المبيعات الكلية</title>
<style>
body{font-family:Tahoma;text-align:center;}
h2{text-align:center}
table{width:100%;border-collapse:collapse;margin-top:20px}
td,th{border:1px solid #000;padding:5px;text-align:center}
</style>
</head>
<body>
<h2>جدول المبيعات الكلية</h2>
<table>
<tr><th>الصنف</th><th>السعر</th></tr>
${salesHistory.map(x=>`<tr><td>${x.emoji} ${x.name}</td><td>${x.price}</td></tr>`).join("")}
<tr><th>المجموع الكلي</th><th>${salesHistory.reduce((a,b)=>a+b.price,0)}</th></tr>
</table>
</body>
</html>
`);
w.document.close();
}
</script>

</body>
</html>
